<Page
    x:Class="Screenlocker.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,12,16,32">

                <TextBlock Text="锁屏文字" FontSize="28" FontWeight="Light" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,2"
                           Text="下面写的字会显示到锁屏的“详细状态”和动态磁贴上。" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="详细状态最多三行，所以模板也最多写三行；超出的行会并到第三行。" />

                <TextBlock Text="模板" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <TextBox x:Name="TemplateBox"
                         AcceptsReturn="True"
                         Height="110"
                         FontFamily="Consolas"
                         FontSize="14"
                         Margin="0,0,0,4"
                         TextWrapping="Wrap"
                         TextChanged="TemplateBox_TextChanged"
                         PlaceholderText="{}{time}  {weekday}&#x0a;电量 {battery}{charging}&#x0a;{city} {temp}°C {weather}" />
                <TextBlock x:Name="LineHint" Style="{StaticResource HintText}" />

                <TextBlock Text="插入占位符" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="时间" Style="{StaticResource ChipButton}" Tag="{}{time}" Click="Placeholder_Click" />
                    <Button Grid.Row="0" Grid.Column="1" Content="12 小时" Style="{StaticResource ChipButton}" Tag="{}{time12}" Click="Placeholder_Click" />
                    <Button Grid.Row="0" Grid.Column="2" Content="日期" Style="{StaticResource ChipButton}" Tag="{}{date}" Click="Placeholder_Click" />

                    <Button Grid.Row="1" Grid.Column="0" Content="月/日" Style="{StaticResource ChipButton}" Tag="{}{md}" Click="Placeholder_Click" />
                    <Button Grid.Row="1" Grid.Column="1" Content="星期" Style="{StaticResource ChipButton}" Tag="{}{weekday}" Click="Placeholder_Click" />
                    <Button Grid.Row="1" Grid.Column="2" Content="电量" Style="{StaticResource ChipButton}" Tag="{}{battery}" Click="Placeholder_Click" />

                    <Button Grid.Row="2" Grid.Column="0" Content="电量数字" Style="{StaticResource ChipButton}" Tag="{}{batteryNum}" Click="Placeholder_Click" />
                    <Button Grid.Row="2" Grid.Column="1" Content="充电符号" Style="{StaticResource ChipButton}" Tag="{}{charging}" Click="Placeholder_Click" />
                    <Button Grid.Row="2" Grid.Column="2" Content="城市" Style="{StaticResource ChipButton}" Tag="{}{city}" Click="Placeholder_Click" />

                    <Button Grid.Row="3" Grid.Column="0" Content="温度" Style="{StaticResource ChipButton}" Tag="{}{temp}" Click="Placeholder_Click" />
                    <Button Grid.Row="3" Grid.Column="1" Content="天气" Style="{StaticResource ChipButton}" Tag="{}{weather}" Click="Placeholder_Click" />
                    <Button Grid.Row="3" Grid.Column="2" Content="湿度" Style="{StaticResource ChipButton}" Tag="{}{humidity}" Click="Placeholder_Click" />

                    <Button Grid.Row="4" Grid.Column="0" Content="纬度" Style="{StaticResource ChipButton}" Tag="{}{lat}" Click="Placeholder_Click" />
                    <Button Grid.Row="4" Grid.Column="1" Content="经度" Style="{StaticResource ChipButton}" Tag="{}{lon}" Click="Placeholder_Click" />
                    <Button Grid.Row="4" Grid.Column="2" Content="换行" Style="{StaticResource ChipButton}" Tag="&#x0a;" Click="Placeholder_Click" />
                </Grid>

                <TextBlock Text="预览（锁屏详细状态 / 宽磁贴）" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <Border Background="#1A808080" CornerRadius="6" Padding="12" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock x:Name="PreviewLine1" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock x:Name="PreviewLine2" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="PreviewLine3" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="PreviewNote" Style="{StaticResource HintText}" />

                <TextBlock Text="刷新与数据" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <ToggleSwitch x:Name="AutoRefreshSwitch" Header="后台自动刷新" OnContent="开" OffContent="关" Margin="0,0,0,4" Toggled="Setting_Changed" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="间隔" VerticalAlignment="Center" />
                    <ComboBox x:Name="IntervalBox" Width="150" Margin="8,0,0,0" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="15 分钟" Tag="15" />
                        <ComboBoxItem Content="30 分钟" Tag="30" />
                        <ComboBoxItem Content="1 小时" Tag="60" />
                        <ComboBoxItem Content="3 小时" Tag="180" />
                    </ComboBox>
                </StackPanel>
                <ToggleSwitch x:Name="NetworkSwitch" Header="联网获取天气（open-meteo）" OnContent="开" OffContent="关" Margin="0,0,0,4" Toggled="Setting_Changed" />
                <ToggleSwitch x:Name="LocationSwitch" Header="用定位识别城市" OnContent="开" OffContent="关" Margin="0,0,0,4" Toggled="Setting_Changed" />
                <TextBox x:Name="CityBox" Header="固定城市名（留空 = 用定位反查）" PlaceholderText="例如 杭州" Margin="0,0,0,4" TextChanged="Setting_TextChanged" />
                <ToggleSwitch x:Name="BadgeSwitch" Header="锁屏徽章显示电量" OnContent="开" OffContent="关" Toggled="Setting_Changed" />

                <TextBlock Text="操作" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="SaveButton" Content="保存并刷新" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
                    <Button x:Name="RefreshButton" Content="立即刷新" Margin="8,0,0,0" Click="Refresh_Click" />
                    <ProgressRing x:Name="BusyRing" Width="20" Height="20" Margin="8,0,0,0" IsActive="False" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="LockSettingsButton" Content="打开锁屏设置" HorizontalAlignment="Stretch" Margin="0,0,0,4" Click="LockSettings_Click" />
                <TextBlock x:Name="StatusText" Style="{StaticResource HintText}" Margin="0,0,0,4" />

                <TextBlock Text="怎么让它出现在锁屏上" Style="{StaticResource SectionHeader}" Margin="0,10,0,4" />
                <TextBlock Style="{StaticResource HintText}" Text="1. 保存模板后，磁贴上立刻就有字了。" />
                <TextBlock Style="{StaticResource HintText}" Text="2. 锁屏详细状态要手动选一次：设置 → 个性化 → 锁屏界面 → “选择显示详细状态的应用”里选“锁屏文字”。" />
                <TextBlock Style="{StaticResource HintText}" Text="3. 后台定时任务按间隔刷新（系统定时器最短 15 分钟），任务列表里划掉应用也不会停。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
